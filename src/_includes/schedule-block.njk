{#
  Renders the inside of an event-content <td> for one schedule block.
  Requires in parent scope:
    - block (the current block from day.blocks)
    - currentDay (the day key: "wednesday" | "thursday" | "friday")
    - day (the schedule2026.<currentDay> object — used by demo-poster to enumerate paper sessions)
    - papers2026, demos2026, programPillars (from _data)
#}
{% if block.type == "keynote" %}
    <p class="event-title mb-1"><i class="bi bi-mic-fill event-icon"></i>{{ block.title }} — {{ block.speakerName }}</p>
    <p class="event-meta">{{ block.speakerDesc }}<br><i class="bi bi-geo-alt me-1"></i>{{ block.room }}</p>

{% elif block.type == "closing" %}
    <p class="event-title mb-1"><i class="bi bi-flag-fill event-icon"></i>{{ block.title }}</p>
    <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }}</p>

{% elif block.type == "paper-session" %}
    <details class="session-details">
        <summary>
            <p class="event-title mb-1"><i class="bi bi-collection event-icon"></i>{{ block.session }}: {{ block.theme }}<i class="bi bi-chevron-right chevron"></i></p>
            <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }} · {{ block.talkFormat }}</p>
        </summary>
        <table class="talk-list">
            <tbody>
            {% for slug in block.talks %}
                {% for paper in papers2026 %}
                    {% if paper.slug == slug %}
                        <tr>
                            <td class="talk-time">{{ paper.talk.start }}</td>
                            <td class="talk-title"><a href="/program/2026/papers/{{ paper.slug }}/">{{ paper.title }}</a></td>
                        </tr>
                    {% endif %}
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
    </details>

{% elif block.type == "demo-poster" %}
    {% set dayDemoCount = 0 %}
    {% for demo in demos2026 %}{% if demo.day == currentDay %}{% set dayDemoCount = dayDemoCount + 1 %}{% endif %}{% endfor %}
    {% set dayPosterCount = 0 %}
    {% for paper in papers2026 %}{% if paper.talk.day == currentDay %}{% set dayPosterCount = dayPosterCount + 1 %}{% endif %}{% endfor %}
    <details class="session-details">
        <summary>
            <p class="event-title mb-1"><i class="bi bi-display event-icon"></i>{{ block.title }}<i class="bi bi-chevron-right chevron"></i></p>
            <p class="event-meta">
                <strong>{{ dayDemoCount }}</strong> demos · {{ block.demoRoom }}<br>
                <strong>{{ dayPosterCount }}</strong> research posters · {{ block.posterRoom }}
            </p>
        </summary>

        <section class="dp-section">
            <h4 class="dp-section-title">Demos</h4>
            <div class="pillar-mix">
                {% for pillar in programPillars %}
                    {% set pillarCount = 0 %}
                    {% for demo in demos2026 %}
                        {% if demo.day == currentDay and demo.primaryPillar == pillar.title %}
                            {% set pillarCount = pillarCount + 1 %}
                        {% endif %}
                    {% endfor %}
                    {% if pillarCount > 0 %}
                        <span class="pillar-chip"><span class="pillar-dot" style="background:{{ pillar.color }};"></span>{{ pillar.title }}<span class="pillar-count">{{ pillarCount }}</span></span>
                    {% endif %}
                {% endfor %}
            </div>

            {% for pillar in programPillars %}
                {% set pillarDemos = [] %}
                {% for demo in demos2026 %}
                    {% if demo.day == currentDay and demo.primaryPillar == pillar.title %}
                        {% set pillarDemos = (pillarDemos.push(demo), pillarDemos) %}
                    {% endif %}
                {% endfor %}
                {% if pillarDemos | length > 0 %}
                    <div class="dp-group">
                        <h5 class="dp-group-title">
                            <i class="bi {{ pillar.icon }}" style="color: {{ pillar.color }};"></i>{{ pillar.title }}
                            <span class="dp-count">{{ pillarDemos | length }}</span>
                        </h5>
                        <ul class="dp-list">
                            {% for demo in pillarDemos %}
                                <li><a href="/program/2026/demos/{{ demo.slug }}/">{{ demo.title }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            {% endfor %}

            <p class="dp-browse"><a href="/program/2026/demos/">Browse all accepted demos →</a></p>
        </section>

        <hr class="dp-divider">

        <section class="dp-section">
            <h4 class="dp-section-title">Research Posters</h4>
            {% for sessBlock in day.blocks %}
                {% if sessBlock.type == "paper-session" %}
                    <div class="dp-group">
                        <h5 class="dp-group-title">
                            <i class="bi bi-collection" style="color: var(--terracotta-medium);"></i>{{ sessBlock.session }}: {{ sessBlock.theme }}
                            <span class="dp-count">{{ sessBlock.talks | length }}</span>
                        </h5>
                        <ul class="dp-list">
                            {% for slug in sessBlock.talks %}
                                {% for paper in papers2026 %}
                                    {% if paper.slug == slug %}
                                        <li><a href="/program/2026/papers/{{ paper.slug }}/">{{ paper.title }}</a></li>
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            {% endfor %}
        </section>
    </details>

{% elif block.type == "workshop-session" %}
    {% set slotWorkshops = [] %}
    {% for ws in workshops2026 %}
        {% if ws.duration == "full-day" or ws.duration == block.slot %}
            {% set slotWorkshops = (slotWorkshops.push(ws), slotWorkshops) %}
        {% endif %}
    {% endfor %}
    <p class="event-title mb-1"><i class="bi bi-lightbulb event-icon"></i>{{ block.title }}</p>
    <p class="event-meta mb-2">{{ slotWorkshops | length }} sessions in parallel</p>
    {% if block.breakStart %}
    <div class="coffee-break-note">
        <i class="bi bi-cup-hot"></i>
        <span><strong>Coffee break</strong> · {{ block.breakStart }}–{{ block.breakEnd }} · {{ block.breakRoom }}</span>
    </div>
    {% endif %}
    <table class="talk-list">
        <tbody>
            {% for ws in slotWorkshops %}
                <tr>
                    <td class="talk-time">{{ ws.room }}</td>
                    <td class="talk-title">
                        <a href="{{ ws.url }}" target="_blank" rel="noopener">{{ ws.title }}</a>{% if ws.subtitle %} <span class="small text-muted">— {{ ws.subtitle }}</span>{% endif %}
                        <i class="bi bi-box-arrow-up-right small ms-1"></i>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% elif block.type == "ops" %}
    {% set opsPaper = null %}
    {% if block.talks %}
        {% for paper in papers2026 %}{% if paper.slug == block.talks[0] %}{% set opsPaper = paper %}{% endif %}{% endfor %}
    {% endif %}
    {% if opsPaper %}
        <p class="event-title mb-1"><i class="bi bi-gear event-icon"></i>{{ block.title }}: <a href="/program/2026/papers/{{ opsPaper.slug }}/">{{ opsPaper.title }}</a></p>
        <p class="event-meta">
            {% for author in opsPaper.authors %}{% if author.name and author.name != "TBD" %}<strong>{{ author.name }}</strong>{% if author.affiliation and author.affiliation != "TBD" %} <span class="text-muted">· {{ author.affiliation }}</span>{% endif %}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}
            {% set hasNamedAuthor = false %}
            {% for author in opsPaper.authors %}{% if author.name and author.name != "TBD" %}{% set hasNamedAuthor = true %}{% endif %}{% endfor %}
            {% if hasNamedAuthor %}<br>{% endif %}
            <i class="bi bi-geo-alt me-1"></i>{{ block.room }}
        </p>
    {% else %}
        <p class="event-title mb-1"><i class="bi bi-gear event-icon"></i>{{ block.title }}</p>
        <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }}</p>
    {% endif %}

{% elif block.type == "reception" %}
    <p class="event-title mb-1"><i class="bi bi-cup-straw event-icon"></i>{{ block.title }}</p>
    <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }}{% if block.note %} · <em>{{ block.note }}</em>{% endif %}</p>

{% elif block.type == "meal" %}
    <p class="event-title mb-1"><i class="bi bi-egg-fried event-icon"></i>{{ block.title }}</p>
    <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }}</p>

{% elif block.type == "break" %}
    <p class="event-title mb-1"><i class="bi bi-cup-hot event-icon"></i>{{ block.title }}</p>
    <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }}</p>

{% elif block.type == "info" %}
    <p class="event-title mb-1"><i class="bi bi-info-circle event-icon"></i>{{ block.title }}</p>
    <p class="event-meta"><i class="bi bi-geo-alt me-1"></i>{{ block.room }}{% if block.note %} · {{ block.note }}{% endif %}</p>
{% endif %}
