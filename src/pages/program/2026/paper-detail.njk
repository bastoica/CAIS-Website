---
pagination:
    data: papers2026
    size: 1
    alias: paper
layout: base.njk
permalink: "/program/2026/papers/{{ paper.slug }}/"
eleventyComputed:
    title: "{{ paper.title }} — CAIS 2026"
    description: "{{ paper.summary }}"
extraStyles: |
    .presentation-band {
        border: 1px solid var(--platinum);
        border-left: 4px solid var(--terracotta-deep);
        border-radius: 4px;
        background: color-mix(in srgb, var(--terracotta-deep) 5%, var(--seasalt));
        padding: 1rem 1.25rem;
    }
    .presentation-eyebrow {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--terracotta-deep);
        font-weight: 700;
        margin: 0 0 0.7rem;
    }
    .presentation-block .presentation-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--davys-gray);
        font-weight: 700;
        margin: 0 0 0.3rem;
    }
    .presentation-block .presentation-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--eerie-black);
        margin: 0 0 0.2rem;
    }
    .presentation-block .presentation-when {
        font-size: 0.9rem;
        color: var(--eerie-black);
        margin: 0 0 0.15rem;
    }
    .presentation-block .presentation-where {
        font-size: 0.85rem;
        color: var(--davys-gray);
        margin: 0;
    }
    .presentation-actions {
        margin-top: 1rem;
        padding-top: 0.85rem;
        border-top: 1px solid var(--platinum);
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
---

<header class="hero">
    <div class="container">
        <p class="mb-2"><a href="/program/2026/papers/" class="small"><i class="bi bi-arrow-left me-1"></i>All Accepted Papers</a></p>
        <h1 class="h2 fw-bold mb-3">{{ paper.title }}</h1>
        <p class="mb-2">
            {% for author in paper.authors %}<strong>{{ author.name }}</strong> <span class="text-muted">({{ author.affiliation }})</span>{% if not loop.last %}, {% endif %}{% endfor %}
        </p>
        {% if paper.tags %}
        <p class="mb-0">
            {% for tagTitle in paper.tags %}
                {% for p in programPillars %}
                    {% if p.title == tagTitle %}
                        <span class="badge me-1" style="background-color: {{ p.color }}; color: var(--seasalt); {% if p.title == paper.primaryPillar %}box-shadow: inset 0 0 0 2px var(--eerie-black);{% endif %}"><i class="bi {{ p.icon }} me-1"></i>{{ p.title }}</span>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </p>
        {% endif %}
    </div>
</header>

<div class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">

                <section class="mb-4">
                    <p class="lead">{{ paper.summary }}</p>
                </section>

                {% if paper.talk %}
                    {% set day = schedule2026[paper.talk.day] %}
                    {% set posterBlock = null %}
                    {% for b in day.blocks %}{% if b.type == "demo-poster" %}{% set posterBlock = b %}{% endif %}{% endfor %}
                    <div class="presentation-band mb-5">
                        <p class="presentation-eyebrow"><i class="bi bi-calendar-event me-2"></i>Presentation</p>
                        <div class="row g-4">
                            <div class="col-md-6 presentation-block">
                                <p class="presentation-label">Talk</p>
                                <p class="presentation-title">{{ paper.talk.sessionName }}{% if paper.talk.sessionTheme %}: {{ paper.talk.sessionTheme }}{% endif %}</p>
                                <p class="presentation-when">{{ day.label }} · {{ paper.talk.start }} – {{ paper.talk.end }}</p>
                                <p class="presentation-where"><i class="bi bi-geo-alt me-1"></i>{{ paper.talk.room }}</p>
                            </div>
                            {% if posterBlock and paper.category != "ops" %}
                            <div class="col-md-6 presentation-block">
                                <p class="presentation-label">Poster</p>
                                <p class="presentation-when">{{ day.label }} · {{ posterBlock.start }} – {{ posterBlock.end }}</p>
                                <p class="presentation-where"><i class="bi bi-geo-alt me-1"></i>{{ posterBlock.posterRoom }}</p>
                            </div>
                            {% endif %}
                        </div>
                        <div class="presentation-actions">
                            {% if paper.links.video %}
                            <a href="{{ paper.links.video }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="background:var(--cais-accent); border:none; color:#fff;">
                                <i class="bi bi-play-circle me-2"></i>Watch talk recording
                            </a>
                            {% endif %}
                            <a href="/schedule/2026/{{ paper.talk.day }}/" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-right me-2"></i>View day schedule
                            </a>
                        </div>
                    </div>
                {% endif %}

                <section class="mb-5">
                    <h2 class="section-title h4 border-bottom pb-2">Abstract</h2>
                    <p>{{ paper.abstract | latex | safe }}</p>
                </section>

                {% if paper.keyContributions %}
                <section class="mb-5">
                    <h2 class="section-title h4 border-bottom pb-2">Key Contributions</h2>
                    <ul>
                        {% for item in paper.keyContributions %}<li>{{ item }}</li>{% endfor %}
                    </ul>
                </section>
                {% endif %}

                {% if paper.bibtex %}
                <section class="mb-5">
                    <h2 class="section-title h4 border-bottom pb-2">Cite</h2>
                    <pre class="bg-light p-3 rounded" style="font-size: 0.85rem; white-space: pre-wrap;"><code>{{ paper.bibtex }}</code></pre>
                </section>
                {% endif %}

            </div>

            <div class="col-lg-4">
                <aside>
                    {% if paper.links %}
                    <div class="card dates-card mb-4">
                        <div class="card-body">
                            <h3 class="h6 fw-bold mb-3"><i class="bi bi-link-45deg me-2"></i>Artifacts & Links</h3>
                            <ul class="list-unstyled mb-0">
                                {% if paper.links.pdf %}<li class="mb-2"><a href="{{ paper.links.pdf }}" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-2"></i>Paper (PDF)</a></li>{% endif %}
                                {% if paper.links.alphaxiv %}<li class="mb-2"><a href="{{ paper.links.alphaxiv }}" target="_blank" rel="noopener"><svg class="alphaxiv-icon me-2" viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor"><path d="M34.1375 22.33L40.7973 28.9861L37.9353 31.8408L31.2812 25.2124L34.1375 22.33Z"/><path d="M17.5329 8.81595C19.3415 8.68983 21.0736 9.32514 22.3741 10.5712L27.3268 15.5234L24.4428 18.3781L19.3791 13.3254C18.5408 12.6608 17.4078 12.6922 16.5956 13.3835L6.05955 23.9148L3.20117 21.058L13.9167 10.3477C14.8775 9.49679 16.246 8.90596 17.5329 8.81595Z"/><path d="M37.937 8.86787L40.7954 11.7242L18.9148 33.5938C12.9264 38.6145 5.12162 30.7945 10.1727 24.8271L18.5699 16.4367L21.4283 19.293L13.1661 27.5494C11.4303 29.6594 14.1568 32.3331 16.2359 30.5575L37.937 8.86787Z"/></svg>alphaXiv preprint</a></li>{% endif %}
                                {% if paper.links.github %}<li class="mb-2"><a href="{{ paper.links.github }}" target="_blank" rel="noopener"><i class="bi bi-github me-2"></i>Code (GitHub)</a></li>{% endif %}
                                {% if paper.links.project %}<li class="mb-2"><a href="{{ paper.links.project }}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-2"></i>Project site</a></li>{% endif %}
                                {% if paper.links.video %}<li class="mb-2"><a href="{{ paper.links.video }}" target="_blank" rel="noopener"><i class="bi bi-play-circle me-2"></i>Video</a></li>{% endif %}
                                {% if paper.links.slides %}<li><a href="{{ paper.links.slides }}" target="_blank" rel="noopener"><i class="bi bi-easel me-2"></i>Slides</a></li>{% endif %}
                            </ul>
                        </div>
                    </div>
                    {% endif %}

                    <div class="highlight-box p-3">
                        <h3 class="h6 fw-bold mb-2"><i class="bi bi-people me-2"></i>Authors</h3>
                        <ul class="list-unstyled small mb-0">
                            {% for author in paper.authors %}
                            <li class="mb-1"><strong>{{ author.name }}</strong><br><span class="text-muted">{{ author.affiliation }}</span></li>
                            {% endfor %}
                        </ul>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>
