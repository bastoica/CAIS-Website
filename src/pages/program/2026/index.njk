<section class="py-5 bg-light">
    <div class="container">
        <h2 class="h4 fw-bold mb-4"><i class="bi bi-mic me-2"></i>Keynote Speakers</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="h-100">
                    <div style="aspect-ratio: 4/3; overflow: hidden; border-radius: 0.5rem;">
